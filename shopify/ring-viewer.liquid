{%- comment -%}
  ==========================================================================
  Ring Viewer — 3D engagement ring configurator
  --------------------------------------------------------------------------
  Loads the hosted React / Three.js widget and mounts it into this section.

  SETUP: after adding this section, open its settings in the theme editor and
  set "Widget base URL" to the origin where the built `dist/` folder is
  deployed, with no trailing path — for example:

      https://your-project.vercel.app

  The widget reads every other option below from the data- attributes, so
  changing a setting never requires a rebuild or redeploy.
  ==========================================================================
{%- endcomment -%}

{%- liquid
  assign base = section.settings.asset_base | strip
-%}

<div
  class="ring-viewer-section"
  style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px;"
>
  <div class="ring-viewer-section__inner" style="max-width:{{ section.settings.max_width }}px;margin:0 auto;padding-left:1.5rem;padding-right:1.5rem;">

    {%- if section.settings.heading != blank -%}
      <h2 class="ring-viewer-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if base == blank -%}

      {%- comment -%} Only nag the merchant inside the editor, never on the live storefront. {%- endcomment -%}
      {%- if request.design_mode -%}
        <div style="padding:2rem;border:1px dashed #c9c9c9;border-radius:8px;text-align:center;color:#666;font-size:0.9rem;line-height:1.6;">
          <strong>Ring Viewer</strong><br>
          Set the <em>Widget base URL</em> in this section&rsquo;s settings to load the 3D configurator.
        </div>
      {%- endif -%}

    {%- else -%}

      <link rel="stylesheet" href="{{ base | escape }}/ring-viewer.css">

      <div
        data-ring-viewer
        data-asset-base="{{ base | escape }}"
        data-viewer-height="{{ section.settings.viewer_height }}"
        data-initial-metal="{{ section.settings.initial_metal }}"
        data-initial-halo="{{ section.settings.initial_halo }}"
        data-initial-pave="{{ section.settings.initial_pave }}"
        data-show-title="{{ section.settings.show_title }}"
        data-show-price="{{ section.settings.show_price }}"
        data-show-shapes="{{ section.settings.show_shapes }}"
        data-show-cta="{{ section.settings.show_cta }}"
        data-cta-label="{{ section.settings.cta_label | escape }}"
        data-currency="{{ section.settings.currency | escape }}"
        data-price-base="{{ section.settings.price_base }}"
        data-price-halo="{{ section.settings.price_halo }}"
        data-price-pave="{{ section.settings.price_pave }}"
      ></div>

      <script src="{{ base | escape }}/ring-viewer.js" defer></script>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Ring Viewer",
  "tag": "section",
  "class": "ring-viewer-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Widget source"
    },
    {
      "type": "paragraph",
      "content": "Paste the origin where the built widget is deployed, with no trailing slash (e.g. https://your-project.vercel.app)."
    },
    {
      "type": "text",
      "id": "asset_base",
      "label": "Widget base URL",
      "info": "Required. Loads ring-viewer.js, ring-viewer.css and the 3D models from this origin."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to hide."
    },
    {
      "type": "range",
      "id": "viewer_height",
      "label": "Viewer height",
      "min": 320,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Default selection"
    },
    {
      "type": "select",
      "id": "initial_metal",
      "label": "Metal colour",
      "options": [
        { "value": "yellow", "label": "14k Yellow Gold" },
        { "value": "white", "label": "14k White Gold" },
        { "value": "rose", "label": "14k Rose Gold" }
      ],
      "default": "yellow"
    },
    {
      "type": "checkbox",
      "id": "initial_halo",
      "label": "Start with halo setting",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "initial_pave",
      "label": "Start with pavé band",
      "default": false
    },
    {
      "type": "header",
      "content": "Optional display"
    },
    {
      "type": "paragraph",
      "content": "These are off by default: your product page already shows a title, price and Add to cart. Turning them on shows a second, display-only set that is NOT connected to checkout."
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show ring name",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show indicative price",
      "info": "Display only — this does not affect what the customer is charged.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_shapes",
      "label": "Show diamond shape picker",
      "info": "Only the round shape has a 3D model; the others render as disabled.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show call-to-action button",
      "info": "Not wired to the cart yet.",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Call-to-action label",
      "default": "Choose Diamond"
    },
    {
      "type": "header",
      "content": "Indicative pricing"
    },
    {
      "type": "text",
      "id": "currency",
      "label": "Currency symbol",
      "default": "$"
    },
    {
      "type": "number",
      "id": "price_base",
      "label": "Base price",
      "default": 980
    },
    {
      "type": "number",
      "id": "price_halo",
      "label": "Halo surcharge",
      "default": 350
    },
    {
      "type": "number",
      "id": "price_pave",
      "label": "Pavé surcharge",
      "default": 450
    }
  ],
  "presets": [
    {
      "name": "Ring Viewer"
    }
  ]
}
{% endschema %}
